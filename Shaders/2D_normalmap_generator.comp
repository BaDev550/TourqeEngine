#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uGlobalTextures[];
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uGlobalStorageImages[];

layout(push_constant) uniform PushConstants {
    uint  srcTexIdx;
    uint  dstImgIdx;
    uint  width;
    uint  height;
    float strength;
} pc;

float getHeight(vec2 uv) {
    vec3 c = texture(u_globalTextures[nonuniformEXT(pc.srcTexIdx)], uv).rgb;
    return dot(c, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.width || coord.y >= pc.height) return;

    vec2 texel = 1.0 / vec2(pc.width, pc.height);
    vec2 uv = (vec2(coord) + 0.5) * texel;

    float tl = getHeight(uv + vec2(-texel.x, -texel.y));
    float l  = getHeight(uv + vec2(-texel.x,  0.0));
    float bl = getHeight(uv + vec2(-texel.x,  texel.y));
    float t  = getHeight(uv + vec2( 0.0,     -texel.y));
    float b  = getHeight(uv + vec2( 0.0,      texel.y));
    float tr = getHeight(uv + vec2( texel.x, -texel.y));
    float r  = getHeight(uv + vec2( texel.x,  0.0));
    float br = getHeight(uv + vec2( texel.x,  texel.y));

    float dX = (tr + 2.0 * r + br) - (tl + 2.0 * l + bl);
    float dY = (bl + 2.0 * b + br) - (tl + 2.0 * t + tr);

    vec3 n = normalize(vec3(-dX * pc.strength, -dY * pc.strength, 1.0));
    imageStore(u_globalStorageImages[nonuniformEXT(pc.dstImgIdx)], coord, vec4(n * 0.5 + 0.5, 1.0));
}